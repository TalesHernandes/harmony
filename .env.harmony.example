# Copy to .env.harmony on the machine. Never commit .env.harmony.
#
# harmony has no shared passphrase and no third-party keys: accounts are the
# authentication, and they live in the database. What is left is configuration.

# The public origin. Invite links are built from it, and a write that arrives
# claiming to come from anywhere else is refused.
HARMONY_BASE_URL=https://harmony.taleshernandes.com

# Where the SQLite file lives inside the container. /data is the ./data bind
# mount from docker-compose.harmony.yml.
HARMONY_DB=/data/harmony.db

# Read the client address from X-Forwarded-For. Only ever with a proxy in front
# that overwrites the header — Caddyfile.harmony does. Without that, anyone
# could forge an address and slip past the per-address login limit.
TRUST_PROXY=1

# O servidor de mídia (D2). Sem este endereço o servidor anuncia ao navegador um
# endereço de dentro do contêiner, que ninguém na internet alcança.
HARMONY_VOICE_PUBLIC_IP=

# Notificação com o app fechado (D4). As duas primeiras saem de
# `harmony -vapid-keygen`, rodado uma vez; a privada é um segredo e não volta
# para o git. Vazias, o harmony funciona igual ao D3 e diz no log que a
# campainha está desligada.
#
# Trocar esse par depois não é de graça: todo navegador que assinou com a chave
# pública antiga deixa de ser alcançável e a pessoa tem que ligar de novo.
HARMONY_VAPID_PUBLIC=
HARMONY_VAPID_PRIVATE=
# O "quem opera isto" que vai junto de cada push (RFC 8292). Pode ser um
# https: ou um mailto:. O endereço do próprio serviço é a resposta honesta e não
# põe o e-mail de ninguém na linha do Google.
HARMONY_VAPID_SUBJECT=https://harmony.taleshernandes.com

# O aviso do app Android com ele fechado (A6), pelo Firebase Cloud Messaging.
# É a chave da conta de serviço do projeto harmony-399e9 (o JSON que o console
# do Firebase baixa), inteira, em base64 numa linha só:
#   base64 -w0 harmony-399e9-firebase-adminsdk-*.json
# É o segredo que importa: com ele se manda aviso para todo mundo em nome do
# harmony. Vazia, o Android não recebe aviso e todo o resto funciona igual;
# presente e errada, o servidor se recusa a subir (melhor do que um aviso que
# parece ligado e nunca chega).
HARMONY_FCM_CREDENTIALS=

# Account email. Copy these names into the server's .env.harmony.
# Port 465 uses implicit TLS; 587 requires STARTTLS.
HARMONY_SMTP_HOST=
HARMONY_SMTP_PORT=587
HARMONY_SMTP_USER=
HARMONY_SMTP_PASS=
HARMONY_MAIL_FROM=
# Development/e2e only: write private .eml files instead of sending SMTP.
HARMONY_MAIL_DIR=
# Enable only after mail delivery and all clients support confirmation.
HARMONY_EMAIL_REQUIRED=0
