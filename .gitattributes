# The repository lives on Windows and deploys to Linux by `git archive`, so a
# checkout that helpfully rewrites line endings ships them straight to the
# server. A shell script with CRLF fails as "No such file or directory" —
# the kernel looks for an interpreter called "/bin/sh\r" — which is a long way
# from what it looks like.
#
# Everything below is read by Linux, so it stays LF everywhere.
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
*.Dockerfile text eol=lf
Dockerfile  text eol=lf
Caddyfile.* text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.env.example      text eol=lf
.env.*.example    text eol=lf
*.woff2     binary
