    </ControlTemplate></Setter.Value></Setter>
  </Style>


  <!-- Shared drawing for every popup entry, including keyboard navigation. -->
  <Style TargetType="MenuFlyoutPresenter">
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Background" Value="#27272a"/><Setter Property="Foreground" Value="#fcfcfc"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/>
    <Setter Property="MinWidth" Value="160"/><Setter Property="Padding" Value="4"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuFlyoutPresenter">
      <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
        <ScrollViewer x:Name="MenuFlyoutPresenterScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled"><ItemsPresenter/></ScrollViewer>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuFlyoutItem">
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="FontFamily" Value="ms-appx:///assets/Inter.ttf#Inter"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="#fcfcfc"/><Setter Property="Padding" Value="12,0"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="UseSystemFocusVisuals" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuFlyoutItem">
      <Border x:Name="Item" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Item.Background" Value="#323235"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Item.Background" Value="#323235"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Item.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
        </VisualStateGroup><VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused"/>
          <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="Item.Background" Value="#323235"/></VisualState.Setters></VisualState>
          <VisualState x:Name="PointerFocused"/>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HarmonyDangerMenuItem" TargetType="MenuFlyoutItem">
    <Setter Property="FontWeight" Value="Medium"/><Setter Property="FontFamily" Value="ms-appx:///assets/Inter.ttf#Inter"/>
    <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="12,0"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="Background" Value="#db3b3e"/><Setter Property="Foreground" Value="#fcfcfc"/>
    <Setter Property="UseSystemFocusVisuals" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuFlyoutItem">
      <Border x:Name="DangerItem" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="DangerItem.Background" Value="#e15451"/><Setter Target="DangerText.Foreground" Value="#fcfcfc"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="DangerItem.Background" Value="#b82f32"/><Setter Target="DangerText.Foreground" Value="#fcfcfc"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="DangerItem.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
        </VisualStateGroup><VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused"/><VisualState x:Name="PointerFocused"/>
          <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="DangerItem.Background" Value="#e15451"/><Setter Target="DangerText.Foreground" Value="#fcfcfc"/></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="DangerText" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Auth.tsx: disabled fields keep the same contrast as the web. -->
  <Style x:Key="HarmonyLoginButton" TargetType="Button" BasedOn="{StaticResource HarmonyPrimaryButton}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="LoginSurface" Background="{TemplateBinding Background}" CornerRadius="8">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="LoginSurface.Background" Value="#3592f9"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="LoginSurface.Background" Value="#0370d0"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="LoginSurface.Background" Value="#27272a"/><Setter Target="LoginContent.Foreground" Value="#a1a1aa"/></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <ContentPresenter x:Name="LoginContent" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
      </Border>
