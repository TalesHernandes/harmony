        <ScrollViewer x:Name="ContentElement" Height="24" VerticalAlignment="Center" Padding="0,3,0,0" Foreground="{TemplateBinding Foreground}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" IsTabStop="False" ZoomMode="Disabled"/>
        <TextBlock x:Name="PlaceholderTextContentPresenter" Text="{TemplateBinding PlaceholderText}" Margin="0" VerticalAlignment="Center" Foreground="#a1a1aa" IsHitTestVisible="False"/>
