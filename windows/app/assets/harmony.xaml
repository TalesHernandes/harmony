<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style TargetType="RichTextBlock"><Setter Property="FontWeight" Value="Medium"/></Style>
  <!-- Measurements: queixas/comparacao/web-*.json. Keep the native editing
       parts and automation peers; replace only their drawing and geometry. -->
  <Style x:Key="FieldButton" TargetType="Button">
    <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/><Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Hover" Background="#db3b3e" CornerRadius="8">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Background" Value="#e15451"/><Setter Target="ClearGlyph.Fill" Value="#fcfcfc"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Background" Value="#b82f32"/><Setter Target="ClearGlyph.Fill" Value="#fcfcfc"/></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Path x:Name="ClearGlyph" Fill="#fcfcfc" Data="M 0.22 0.22 C 0.513 -0.073 0.987 -0.073 1.28 0.22 L 4.75 3.689 L 8.22 0.22 C 8.513 -0.073 8.987 -0.073 9.28 0.22 C 9.573 0.513 9.573 0.987 9.28 1.28 L 5.811 4.75 L 9.28 8.22 C 9.573 8.513 9.573 8.987 9.28 9.28 C 8.987 9.573 8.513 9.573 8.22 9.28 L 4.75 5.811 L 1.28 9.28 C 0.987 9.573 0.513 9.573 0.22 9.28 C -0.073 8.987 -0.073 8.513 0.22 8.22 L 3.689 4.75 L 0.22 1.28 C -0.073 0.987 -0.073 0.513 0.22 0.22 Z"><Path.RenderTransform><TranslateTransform X="3.25" Y="3.25"/></Path.RenderTransform></Path></Canvas></Viewbox>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RevealButtonStyle" TargetType="ToggleButton">
    <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/><Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Hover" Background="Transparent" CornerRadius="8">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/><VisualState x:Name="Checked"/>
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Background" Value="#27272a"/></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Hover.Background" Value="#27272a"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Background" Value="#2e2e31"/></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Hover.Background" Value="#2e2e31"/></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M2,12 C6,4 18,4 22,12 C18,20 6,20 2,12 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12" Stroke="#a1a1aa" StrokeThickness="1.7"/></Canvas></Viewbox>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="UseSystemFocusVisuals" Value="False"/>
    <Setter Property="FontFamily" Value="ms-appx:///assets/Inter.ttf#Inter"/><Setter Property="FontSize" Value="16"/><Setter Property="CharacterSpacing" Value="-10"/>
    <Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,0,12,0"/>
    <Setter Property="Foreground" Value="#fcfcfc"/><Setter Property="Background" Value="#18181b"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Grid>
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/>
            <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="BorderElement.BorderThickness" Value="2"/></VisualState.Setters></VisualState>
            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ContentElement.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
          </VisualStateGroup>
          <VisualStateGroup x:Name="ButtonStates"><VisualState x:Name="ButtonCollapsed"/>
            <VisualState x:Name="ButtonVisible"><VisualState.Setters><Setter Target="DeleteButton.Visibility" Value="Visible"/></VisualState.Setters></VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="BorderElement" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="#0485f7"/>
        <!-- WinUI's editing view puts Inter's ink 3px above Chromium's.
             Measured with the same word: 13..24 before, 16..27 on the web. -->
        <ScrollViewer x:Name="ContentElement" Height="24" VerticalAlignment="Center" Padding="12,3,12,0" Foreground="{TemplateBinding Foreground}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" IsTabStop="False" ZoomMode="Disabled"/>
        <TextBlock x:Name="PlaceholderTextContentPresenter" Text="{TemplateBinding PlaceholderText}" Margin="12,0,12,0" VerticalAlignment="Center" Foreground="#a1a1aa" IsHitTestVisible="False"/>
        <Button x:Name="DeleteButton" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" Style="{StaticResource FieldButton}" AutomationProperties.AccessibilityView="Raw"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
