[Unit]
Description=Run the harmony backup daily

[Timer]
# 04:30 UTC is 01:30 in Sao Paulo: nobody is in a voice channel, and the run
# finishes long before anyone wakes up. Persistent so a backup missed while the
# machine was off happens at the next boot instead of being skipped.
OnCalendar=*-*-* 04:30:00 UTC
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
