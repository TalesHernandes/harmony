# Copy to .env beside docker-compose.yml on the coturn instance.
# Examples only: replace all values before use. Never commit .env.
# Generate a separate shared secret with: openssl rand -hex 32
TURN_SECRET=
# Private address of the instance NIC and its public NAT address.
TURN_PRIVATE_IP=10.0.0.10
TURN_PUBLIC_IP=203.0.113.10
