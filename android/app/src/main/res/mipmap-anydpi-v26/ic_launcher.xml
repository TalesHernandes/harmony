<?xml version="1.0" encoding="utf-8"?>
<!-- minSdk is 26, so an adaptive icon is the only one the app needs. No
     monochrome layer: in one colour the two halves of the smile merge into a
     blob, and a themed launcher falls back to the full-colour icon without it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
