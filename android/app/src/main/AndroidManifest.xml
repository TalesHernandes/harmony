<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To reconnect the moment a network comes back, instead of waiting out the backoff. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The voice rooms: the microphone, and routing the call to the loudspeaker or a headset. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- The phone's own camera in a call. Since 0.20 it keeps running with the
         screen off: the call's service takes the camera type while the camera
         is on (it is turned on with the app on screen, as Android 14 asks). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Before Android 12, bringing up a Bluetooth headset's call link. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- The call's service: it keeps the microphone and the network with the
         screen off, shows the notification, and holds the processor awake
         only while a call lasts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A direct call ringing like a telephone: the whole screen, with the
         phone locked (A7). Android 14 lets the person switch it off. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- A new version installed without a cable (A8): the app hands the APK it
         downloaded to Android's installer, and the person confirms. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- allowBackup is off: the session cookie is sealed with a key that lives
         in this phone's keystore and never leaves it, so a restored copy would
         be unreadable anyway, and a backup is one more place for it to be. -->
    <application
        android:name=".HarmonyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="harmony"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The direct call's screen: over the lock screen, the way a
             telephone call is, in a task of its own, out of the recent
             apps: it is a call, not a place to come back to, and the rest
             of the app keeps its own task underneath. -->
        <activity
            android:name=".ui.CallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.taleshernandes.harmony.call"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />
        <!-- Recusar, from the ringing notification. -->
        <receiver
            android:name=".push.CallActions"
            android:exported="false" />
        <!-- Android's installer answering about an update (update/Updater.kt). -->
        <receiver
            android:name=".update.InstallResult"
            android:exported="false" />
        <!-- "Atualizado — toque para abrir", once the new version is in. -->
        <receiver
            android:name=".update.Updated"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".media.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback|mediaProjection|camera" />
        <!-- Where Firebase delivers: numbers only, the text is fetched from
             our server (push/Wake.kt). Not exported: only Google Play
             services reaches it, through Firebase's own receiver. -->
        <service
            android:name=".push.Messaging"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Sends an echo recording to another app (Ajustes → Diagnóstico); only the aecdump folder. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>
</manifest>
