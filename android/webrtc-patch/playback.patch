+// Called at initialization and on the playout thread between writes.
+// Never replace the AudioTrack: mute/unmute cannot interrupt playback.
+private void applyPreferredDevice() {
+PlaybackRoute.Request next = PlaybackRoute.request;
+if (next == null || next == appliedRoute) return;
+if (!audioTrack.setPreferredDevice(next.device)) {
+reportWebRtcAudioTrackError("Preferred output device rejected");
+}
+appliedRoute = next;
+}
